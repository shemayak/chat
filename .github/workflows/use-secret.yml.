name: Use Secret Example

on:
  push:
    branches: [ main ]

jobs:
  use-secret:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Run script that uses secret
        env:
          MY_SECRET: ${{ secrets.MY_APIKEY }}
        run: node scripts/use-secret.js
