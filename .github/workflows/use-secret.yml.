
name: Use Secret Example
on:
  push:
    branches: [ main ]

jobs:
  use-secret:
    runs-on: ubuntu-latest
    env:
      MY_SECRET: ${{ secrets.MY_APIKEY }}   # change SECRET_NAME to your secret
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '18'

      - name: Run script that uses secret
        run: node scripts/use-secret.js   
