name: Use Secret Example
on:
  push:
    branches: [ main ]     # change to your branch / or use on: [push] / workflow_dispatch
jobs:
  use-secret:
    runs-on: ubuntu-latest
    env:
      MY_SECRET: ${{ secrets.MY_APIKEY }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '18'
      - name: Run script that uses secret
        run: node scripts/use-secret.js
